{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "DC Wiring .harness file",
	"description": "A wire harness for the DC Wiring Obsidian plugin. Editing guide: harness-format.md. Unknown fields are kept when the plugin saves.",
	"type": "object",
	"required": ["version"],
	"properties": {
		"$schema": { "type": "string" },
		"$docs": { "type": "string" },
		"version": { "const": 1 },
		"components": { "type": "array", "items": { "$ref": "#/$defs/component" } },
		"wires": { "type": "array", "items": { "$ref": "#/$defs/wire" } },
		"parts": { "type": "array", "items": { "$ref": "#/$defs/part" } },
		"hideWireIds": { "type": "boolean", "description": "Canvas: don't label unnamed wires with their id." },
		"seq": { "type": "object", "additionalProperties": { "type": "integer" }, "description": "Last id number handed out per prefix (C, S, H, W, P). Ids are never reused." },
		"export": {
			"type": "object",
			"description": "Title block and notes of exported drawings and reports.",
			"properties": {
				"company": { "type": "string" },
				"title": { "type": "string" },
				"drawing": { "type": "string", "description": "Drawing number." },
				"date": { "type": "string" },
				"drawnBy": { "type": "string" },
				"notes": { "type": "string" }
			}
		}
	},
	"$defs": {
		"end": {
			"type": "object",
			"required": ["c", "pin"],
			"properties": {
				"c": { "type": "string", "description": "Component id." },
				"pin": { "type": "integer", "minimum": 1, "description": "1-based pin. A splice has only pin 1." }
			}
		},
		"component": {
			"type": "object",
			"required": ["id", "kind"],
			"properties": {
				"id": { "type": "string", "description": "C1 (connector), S1 (splice), H1 (sub-harness block). Unique." },
				"kind": { "enum": ["connector", "splice", "harness"] },
				"name": { "type": "string" },
				"x": { "type": "number" },
				"y": { "type": "number" },
				"pins": { "type": "integer", "minimum": 1, "maximum": 200, "description": "Connector pin count. Splice: 1. Sub-harness block: equals ports.length." },
				"layout": {
					"type": "object",
					"required": ["rows", "cols"],
					"properties": { "rows": { "type": "integer", "minimum": 1 }, "cols": { "type": "integer", "minimum": 1 } },
					"description": "Pin grid, numbered row by row. rows * cols must equal pins."
				},
				"signals": { "type": "object", "propertyNames": { "pattern": "^[0-9]+$" }, "additionalProperties": { "type": "string" }, "description": "Pin number -> signal label." },
				"partId": { "type": "string", "description": "Id of an entry in parts." },
				"exposed": { "type": "boolean", "description": "Connector: its pins show on the block when this file is used as a sub-harness." },
				"file": { "type": "string", "description": "Sub-harness block: vault path of the .harness file." },
				"ports": { "type": "array", "items": { "type": "string", "pattern": "^[^:]+:[0-9]+$" }, "description": "Sub-harness block: \"C4:1\" per pin, in pin order. Only append." },
				"wiringTable": {
					"type": "object",
					"required": ["dx", "dy"],
					"properties": { "dx": { "type": "number" }, "dy": { "type": "number" } },
					"description": "Schematic: wiring table shown at this offset from the component."
				}
			}
		},
		"wire": {
			"type": "object",
			"required": ["id", "from", "to"],
			"properties": {
				"id": { "type": "string", "description": "W1, W2, ... Unique." },
				"name": { "type": "string" },
				"from": { "$ref": "#/$defs/end" },
				"to": { "$ref": "#/$defs/end" },
				"color": { "type": "string", "description": "\"red\", or base/stripe like \"red/white\" or \"rd/ws\"." },
				"gauge": { "type": "string", "description": "mm² like \"0.5\", or \"20AWG\"." },
				"length": { "type": "number", "minimum": 0, "description": "Millimetres." },
				"partId": { "type": "string" },
				"points": {
					"type": "array",
					"items": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
					"description": "Schematic bend points, from -> to."
				}
			}
		},
		"part": {
			"type": "object",
			"required": ["id"],
			"properties": {
				"id": { "type": "string", "description": "P1, P2, ... Unique." },
				"number": { "type": "string" },
				"manufacturer": { "type": "string" },
				"description": { "type": "string" },
				"price": { "type": "number", "description": "Per piece, or per metre when used on wires." }
			}
		}
	}
}
